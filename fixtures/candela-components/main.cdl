// Components on candela: a function returns markup, the markup compiles to a
// fragment at build time, and the call instantiates it. `main.lmn` writes
// `<Home name="bob"/>` too, which reaches the same block through the
// function's name.
import "lumen.cdl";

// One argument, read once when the instance is built.
fn Home(name) {
    return lmn!(<label class="home" text="home for $name"/>);
}

// A `<for>` inside a block meets two scopes: `$prefix` is the argument the
// instance was built with, `{row.title}` is the record the reconciler renders.
fn Rows(prefix) {
    return lmn!(
        <column class="rows">
            <for each="rows" key="id">
                <label class="row" text="$prefix: {row.title}"/>
            </for>
        </column>
    );
}

// A component element is a use site. Both of these are baked into this
// block's body at build time, so the tree is whole from the first frame.
fn App() {
    return lmn!(
        <column id="app">
            <Home name="bob"/>
            <Rows prefix="Row"/>
        </column>
    );
}

// Two levels, with the prop forwarded down. Neither function has anything to
// work out, so both are baked and `<Outer t="x"/>` needs no call.
fn Inner(t) {
    return lmn!(<label class="inner" text="in $t"/>);
}

fn Outer(t) {
    return lmn!(<column class="outer"><Inner t="$t"/></column>);
}

// A body that is one component element: this block is a fragment whose single
// root is that use site, which is what markup naming `Passthru` reaches.
fn Passthru(t) {
    return lmn!(<Inner t="$t"/>);
}

// Works a value out, so the block cannot stand in for the call. What the build
// leaves is a marker, and the runtime fills it by calling this.
fn Shout(who) {
    let loud = who + "!";
    return lmn!(<label class="shout" text="hey $loud"/>);
}

// Picks between blocks. Both are compiled and travel in the artifact; the call
// decides which one is used.
fn Pick(on) {
    if on == "yes" { return lmn!(<label class="arm" text="on"/>); }
    return lmn!(<label class="arm" text="off"/>);
}

// The other direction: a block instantiates a `<template>` the markup
// declares. A template and a block are one entity, so either authoring form
// reaches the other.
fn Wrap() {
    return lmn!(<column id="wrap"><card title="from a block"/></column>);
}

fn on_ready() {
    lumen::signal_array_set("rows", [
        {"id": "a", "title": "Alpha"},
        {"id": "b", "title": "Beta"}
    ]);
    lumen::mount(App());
    lumen::mount(Wrap());
}

fn main() {}
