<root>
  <template name="card"><label class="card" text="{$title}"/></template>
  <column id="stage">
    <Home name="bob" />
    <Outer t="x" />
    <Passthru t="y" />
    <Shout who="ann" />
    <Pick on="yes" />
    <Pick on="no" />
  </column>
  <for each="rows" key="id">
    <Ticket title="{title}" />
  </for>
  <script src="main.cdl" />
</root>
