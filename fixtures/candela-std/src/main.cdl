// The candela standard library, reached from an app the way an app reaches it:
// explicit imports of the C-backed modules for the wall clock and the maths
// library, and the array methods the compiler pulls in from `std/list` with no
// import at all.
import "lumen.cdl";
import "std/time";
import "std/math" as math;

fn on_start() {
    lumen::signal_set("clock", string(time::now()));
    let counts = [1, 2, 3];
    lumen::signal_set("total", string(counts.sum()));
    lumen::signal_set("root", string(math::sqrt(16.0)));
}

fn main() {}
