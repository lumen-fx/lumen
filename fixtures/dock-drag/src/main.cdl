// Says where each panel goes, one line a move, for whoever drives the drag.
import "lumen.cdl";

fn on_move(ev: int) {
    let detail = as_map(lumen::event_detail(ev));
    let panel = lumen::node_id(lumen::event_target(ev));
    print("dock-drag " + panel + " " + as_str(detail.get("to")));
}

fn on_ready() {
    lumen::event_on(lumen::node_get_by_id("editor"), "panelmove", "on_move");
    print("dock-drag ready");
}

fn main() {}
