// The app drives its own window: a new title and size on the first tick, a
// report of what the window has once the platform applied them, then a close
// that on_close vetoes once before letting it through.
import "lumen.cdl";

fn on_ready() {
    window::set_title("lumen-window-check");
    window::set_size(640.0, 480.0);
    lumen::signal_set("state", "asked");
    lumen::set_timeout("report", 250);
}

fn on_timer(name) {
    if name == "report" {
        // The platform applies the change on its own time, and a slow first
        // frame can hold it back; look again until the window has it, or
        // for ten seconds.
        let size = window::size();
        let tries = signal<int>("tries");
        let applied = window::title() == "lumen-window-check" && size[0] == 640.0 && size[1] == 480.0;
        if !applied && tries.get() < 40 {
            tries.set(tries.get() + 1);
            lumen::set_timeout("report", 250);
            return;
        }
        print("window-check title=" + window::title() + " size=" + str(size[0]) + "x" + str(size[1]));
        lumen::signal_set("state", "reported");
        // Long enough for a test runner to read the window back from the
        // platform before the app closes it.
        lumen::set_timeout("leave", 15000);
    } else {
        window::close();
    }
}

fn on_close() {
    let size = window::size();
    print("window-check on_close title=" + window::title() + " size=" + str(size[0]) + "x" + str(size[1]));
    let closes = signal<int>("closes");
    let seen = closes.get();
    closes.set(seen + 1);
    if seen == 0 {
        print("window-check vetoed the first close");
        lumen::set_timeout("leave", 500);
        return false;
    }
    print("window-check closing");
    return true;
}

fn main() {}
