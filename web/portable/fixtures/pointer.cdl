// Binds every pointer event, and the click, on one element and records what each handler was
// told, where a test can read it as signals.
import "lumen.cdl";

fn main() {}

fn on_ready() {
    let pad = lumen::node_get_by_id("pad");
    lumen::event_on(pad, "pointerdown", "on_pointer");
    lumen::event_on(pad, "pointermove", "on_pointer");
    lumen::event_on(pad, "pointerup", "on_pointer");
    lumen::event_on(pad, "wheel", "on_pointer");
    lumen::event_on(pad, "pointerenter", "on_pointer");
    lumen::event_on(pad, "pointerleave", "on_pointer");
    lumen::event_on(pad, "click", "on_pointer");
}

// One handler for every type: `<type>_count` counts the calls, and the rest
// are what the last call of that type carried.
fn on_pointer(ev: int) {
    let kind = lumen::event_type(ev);
    lumen::signal_set_int(kind + "_count", lumen::signal_get_int(kind + "_count") + 1);
    lumen::signal_set_float(kind + "_x", lumen::event_client_x(ev));
    lumen::signal_set_float(kind + "_y", lumen::event_client_y(ev));
    lumen::signal_set_float(kind + "_delta_y", lumen::event_delta_y(ev));
    lumen::signal_set_int(kind + "_delta_mode", lumen::event_delta_mode(ev));
    lumen::signal_set_int(kind + "_button", lumen::event_button(ev));
    // What the device reported.
    lumen::signal_set(kind + "_pointer_type", lumen::event_pointer_type(ev));
    lumen::signal_set_int(kind + "_pointer_id", lumen::event_pointer_id(ev));
    lumen::signal_set_int(kind + "_buttons", lumen::event_buttons(ev));
    lumen::signal_set_float(kind + "_pressure", lumen::event_pressure(ev));
    lumen::signal_set_float(kind + "_tilt_x", lumen::event_tilt_x(ev));
    lumen::signal_set_float(kind + "_twist", lumen::event_twist(ev));
    // Where the pointer was on the element itself.
    lumen::signal_set_float(kind + "_local_x", lumen::event_x(ev));
    lumen::signal_set_float(kind + "_local_y", lumen::event_y(ev));
    // What `pointer_state()` said while the handler ran.
    let state = lumen::pointer_state();
    lumen::signal_set(kind + "_state_x", state["x"]);
    lumen::signal_set(kind + "_state_buttons", state["buttons"]);
}
