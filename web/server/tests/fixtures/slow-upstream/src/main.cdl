// Asks the upstream the query string names, and shows what it answered.
import "lumen.cdl";

fn main() {}

fn on_start() {
    lumen::signal_set("status", "asking");
    let upstream = window::location_query();
    if upstream != "" {
        lumen::fetch(upstream, "upstream");
    }
}

fn on_fetch(tag: string, body: string) {
    lumen::signal_set("status", body);
}

fn on_fetch_error(tag: string, message: string) {
    lumen::signal_set("status", "failed");
}
