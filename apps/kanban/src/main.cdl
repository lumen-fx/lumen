// Lanes: kanban board logic.
//
// Source of truth: the `cards` array signal, each item a record
// {id, title, tag, col}. The three <for> lists (view_backlog / view_doing /
// view_done) are rebuilt from it, filtered by the search box, on every
// mutation. Per-column counts feed derive()d header labels and the board
// summary.

import "lumen.cdl";

fn field(item: any, key: string) {
    return as_str(as_map(item).get(key));
}

fn card_matches(item: any, ql: string) {
    if ql == "" { return true; }
    let title = field(item, "title");
    return title.lowercase().contains(ql);
}

fn build_view(all: any[], col: string, ql: string) {
    let view = [];
    for item in all {
        if field(item, "col") == col && card_matches(item, ql) {
            let tag = field(item, "tag");
            let row = {
                "id": field(item, "id"),
                "title": field(item, "title"),
                "tag": tag,
                "tag_class": "tag-" + tag
            };
            view.push(row);
        }
    }
    return view;
}

fn all_cards() {
    let all = signal_array("cards").all();
    return as_list(all);
}

fn refresh_board() {
    let all = all_cards();
    let ql = signal<string>("search").get().lowercase();
    for col in ["backlog", "doing", "done"] {
        let view = build_view(all, col, ql);
        signal_array("view_" + col).set(view);
        let count = str(view.len());
        lumen::signal_set("count_" + col, count);
    }
}

fn find_index(cur: any[], key: string) {
    let i = 0;
    while i < cur.len() {
        if field(cur[i], "id") == key { return i; }
        i += 1;
    }
    return -1;
}

fn open_editor(mode: string, key: string, title: string, tag: string, col: string, heading: string) {
    lumen::signal_set("editor_mode", mode);
    lumen::signal_set("edit_id", key);
    lumen::signal_set("draft_title", title);
    lumen::signal_set("draft_tag", tag);
    lumen::signal_set("draft_col", col);
    lumen::signal_set("editor_heading", heading);
    lumen::signal_set("editor_open", "1");
}

fn open_add(id: string) {
    open_editor("add", "", "", "feature", "backlog", "New card");
}

fn edit_card(key: string) {
    let cur = all_cards();
    let idx = find_index(cur, key);
    if idx < 0 { return; }
    let it = cur[idx];
    open_editor("edit", key, field(it, "title"), field(it, "tag"), field(it, "col"), "Edit card");
}

fn save_card(id: string) {
    let title = signal<string>("draft_title").get().trim();
    if title == "" {
        lumen::signal_set("editor_open", "");
        return;
    }
    let tag = signal<string>("draft_tag").get();
    let col = signal<string>("draft_col").get();
    let mode = signal<string>("editor_mode").get();
    let cards = signal_array("cards");
    let cur = all_cards();

    if mode == "edit" {
        let key = signal<string>("edit_id").get();
        let idx = find_index(cur, key);
        if idx >= 0 {
            let it = as_map(cur[idx]);
            it.insert("title", title);
            it.insert("tag", tag);
            it.insert("col", col);
        }
    } else {
        let next_id = signal<int>("next_id");
        let n = next_id.get();
        next_id.set(n + 1);
        let card = {"id": "c" + str(n), "title": title, "tag": tag, "col": col};
        cur.push(card);
    }
    cards.set(cur);
    lumen::signal_set("editor_open", "");
    refresh_board();
}

fn cancel_edit(id: string) {
    lumen::signal_set("editor_open", "");
}

fn col_index(col: string) {
    if col == "backlog" { return 0; }
    if col == "doing" { return 1; }
    return 2;
}

fn move_card(key: string, dir: int) {
    let cols = ["backlog", "doing", "done"];
    let cards = signal_array("cards");
    let cur = all_cards();
    let idx = find_index(cur, key);
    if idx < 0 { return; }
    let it = as_map(cur[idx]);
    let ci = col_index(as_str(it.get("col"))) + dir;
    if ci < 0 { ci = 0; }
    if ci > 2 { ci = 2; }
    it.insert("col", cols[ci]);
    cards.set(cur);
    refresh_board();
}

fn without_card(cur: any[], key: string) {
    let kept = as_list(lumen::parse_json("[]"));
    for item in cur {
        if field(item, "id") != key { kept.push(item); }
    }
    return kept;
}

fn delete_card(key: string) {
    let cards = signal_array("cards");
    let kept = without_card(all_cards(), key);
    cards.set(kept);
    refresh_board();
}

fn col_from_target(tid: string) {
    if tid == "lane-backlog" { return "backlog"; }
    if tid == "lane-doing" { return "doing"; }
    if tid == "lane-done" { return "done"; }
    return "";
}

// In-app drag-and-drop landing point. `target_id` is the lane the card was
// released over; `payload` is the dragged card's id (its `drag-payload`).
// Reassign the card's column and re-append so it lands at the bottom of the
// new lane, then let the reactive board rebuild move it.
fn on_drop(target_id: string, payload: string) {
    let col = col_from_target(target_id);
    if col == "" { return; }
    let cards = signal_array("cards");
    let cur = all_cards();
    let idx = find_index(cur, payload);
    if idx < 0 { return; }
    let it = as_map(cur[idx]);
    if as_str(it.get("col")) == col { return; }
    it.insert("col", col);
    let kept = without_card(cur, payload);
    kept.push(it);
    cards.set(kept);
    refresh_board();
}

fn card(id: string, title: string, tag: string, col: string) {
    return {"id": id, "title": title, "tag": tag, "col": col};
}

fn seed_cards() {
    let list = [];
    list.push(card("c1", "Ship the reconciler fast-path", "feature", "done"));
    list.push(card("c2", "Popup edge-flip near viewport bottom", "bug", "done"));
    list.push(card("c3", "Grid track sizing (fr + minmax)", "feature", "doing"));
    list.push(card("c4", "Retint dropdown panels to app tokens", "design", "doing"));
    list.push(card("c5", "Wire @media width to live viewport", "feature", "backlog"));
    list.push(card("c6", "Audit CSS warnings across examples", "chore", "backlog"));
    signal_array("cards").set(list);
}

fn count_label(n: any) {
    let s = str(n);
    if s == "1" { return "1 card"; }
    return s + " cards";
}

// Derived display signals. Each recompute body is referenced by function
// name; its parameters arrive as the current values of the declared deps.
fn calc_board_summary(b: any, d: any, dn: any) {
    return str(b) + " queued | " + str(d) + " active | " + str(dn) + " shipped";
}

// Live search: `<input bind-text="search">` mirrors every keystroke into the
// `search` signal on its own. Lumen is reactive-only, so there is no per-frame
// hook to poll it from; this derivation re-runs refresh_board() whenever
// `search` changes, which is what derive()'s dependency tracking is for. The
// derived signal itself is not read anywhere; it carries the refilter.
fn calc_search_filter(s: any) {
    refresh_board();
    return str(s);
}

fn on_start() {
    lumen::signal_set("search", "");
    lumen::signal_set("editor_open", "");
    signal<int>("next_id").set(7);

    seed_cards();

    lumen::derive("hdr_backlog", ["count_backlog"], "count_label");
    lumen::derive("hdr_doing", ["count_doing"], "count_label");
    lumen::derive("hdr_done", ["count_done"], "count_label");
    lumen::derive("board_summary", ["count_backlog", "count_doing", "count_done"], "calc_board_summary");
    lumen::derive("search_filter", ["search"], "calc_search_filter");

    lumen::on("click", "new-card", "open_add");
    lumen::on("click", "editor-save", "save_card");
    lumen::on("click", "editor-cancel", "cancel_edit");

    refresh_board();
}

// Card buttons carry interpolated ids (`dl|c3`, `ml|c3`, ...); no per-id
// handler is registered for them, so their clicks fall through to on_click.
fn on_click(id: string) {
    if id.len() <= 3 { return; }
    let key = id[3..id.len()];
    if id.starts_with("dl|") { delete_card(key); return; }
    if id.starts_with("ml|") { move_card(key, -1); return; }
    if id.starts_with("mr|") { move_card(key, 1); return; }
    if id.starts_with("ed|") { edit_card(key); return; }
}

fn main() {}
