// Datagrid: a live market feed on a virtualized list.
//
// Pulls the top 80 coins from CoinGecko's public /coins/markets endpoint
// every 30 s, virtualizes the rendered rows, and keeps a per-symbol
// sparkline of the last 8 observed prices.
//
// The `rows` array signal holds every coin as a record. Besides the display
// fields the row markup binds, each record keeps its raw price, volume, and
// price history, so the next refresh can roll the history forward. `visible`
// is `rows` filtered by the search box, and is what the <for> renders.

import "lumen.cdl";

// A record whose fields can hold values of different types. A map literal
// holds one value type; a map read back from parse_json takes any.
fn new_record() {
    return as_map(lumen::parse_json("{}"));
}

fn empty_list() {
    return as_list(lumen::parse_json("[]"));
}

// A JSON number as a float; anything else (a missing price, a null) is 0.
fn num(v: any) {
    if is_float(v) { return as_float(v); }
    if is_int(v) { return float(as_int(v)); }
    return 0.0;
}

fn num_field(item: {any: any}, key: string) {
    if !item.contains(key) { return 0.0; }
    return num(item.get(key));
}

fn tenths(v: float, unit: float, suffix: string) {
    let m = int(v / unit);
    return str(m / 10) + "." + str(m % 10) + suffix;
}

fn fmt_price(v: float) {
    let scale = 100;
    if v.abs() < 1.0 { scale = 100000; }
    else if v.abs() < 100.0 { scale = 1000; }
    let cents = int(v * float(scale));
    let frac = str((cents % scale).abs());
    let width = str(scale).len() - 1;
    while frac.len() < width { frac = "0" + frac; }
    return str(cents / scale) + "." + frac;
}

fn fmt_volume(v: float) {
    if v >= 1000000000.0 { return tenths(v, 100000000.0, "B"); }
    if v >= 1000000.0 { return tenths(v, 100000.0, "M"); }
    if v >= 1000.0 { return tenths(v, 100.0, "k"); }
    return str(int(v));
}

fn fmt_change(pct: float) {
    let sign = "";
    if pct > 0.0 { sign = "+"; }
    let cents = int(pct * 100.0);
    let frac = str((cents % 100).abs());
    if frac.len() < 2 { frac = "0" + frac; }
    return sign + str(cents / 100) + "." + frac + "%";
}

fn fmt_cap(v: float) {
    if v >= 1000000000000.0 { return "$" + tenths(v, 100000000000.0, "T"); }
    if v >= 1000000000.0 { return "$" + tenths(v, 100000000.0, "B"); }
    return "$" + str(int(v));
}

// Bucket a normalized 0..1 trend value into one of 8 discrete height levels.
// The row markup picks a CSS class per bucket (lvl-0..lvl-7 in main.css), so
// the sparkline draws as real bars instead of a block-glyph string; that
// keeps the chart independent of whatever font glyphs are installed.
fn bucket_for(t: float) {
    let level = int(t * 8.0);
    if level < 0 { level = 0; }
    if level > 7 { level = 7; }
    return str(level);
}

fn sparkline_buckets(hist: float[]) {
    let lo = hist[0];
    let hi = hist[0];
    for p in hist {
        if p < lo { lo = p; }
        if p > hi { hi = p; }
    }
    let range = hi - lo;
    if range < 0.0001 { range = 0.0001; }
    let out = [];
    for p in hist {
        out.push(bucket_for((p - lo) / range));
    }
    return out;
}

fn dir_for(pct: float) {
    if pct > 0.0001 { return "up"; }
    if pct < -0.0001 { return "down"; }
    return "flat";
}

fn refresh_counts(total: int, vis: int) {
    let label = str(vis);
    if vis != total { label = label + " / " + str(total); }
    signal<string>("rows_label").set(label);
}

fn rebuild_visible() {
    let cur = as_list(signal_array("rows").all());
    let filt = signal<string>("filter").get().uppercase();
    let out = empty_list();
    for r in cur {
        if filt == "" || as_str(as_map(r).get("symbol")).contains(filt) {
            out.push(r);
        }
    }
    signal_array("visible").set(out);
    let empty = "";
    if out.len() == 0 { empty = "1"; }
    signal<string>("empty_visible").set(empty);
    refresh_counts(cur.len(), out.len());
}

// The previous refresh's history for `sym` with `price` appended and the
// oldest entry dropped, or eight copies of `price` for a new symbol.
fn next_history(prev_idx: {string: any}, sym: string, price: float) {
    let hist = [];
    if prev_idx.contains(sym) {
        let prev = as_list(as_map(prev_idx.get(sym)).get("history"));
        let k = 1;
        while k < prev.len() {
            hist.push(as_float(prev[k]));
            k += 1;
        }
        hist.push(price);
    } else {
        let k = 0;
        while k < 8 {
            hist.push(price);
            k += 1;
        }
    }
    return hist;
}

fn make_row(item: {any: any}, prev_idx: {string: any}, rank: int) {
    let sym = as_str(item.get("symbol")).uppercase();
    let price = num_field(item, "current_price");
    let pct = num_field(item, "price_change_percentage_24h");
    let vol = num_field(item, "total_volume");
    let hist = next_history(prev_idx, sym, price);

    let r = new_record();
    r.insert("id", sym);
    r.insert("symbol", sym);
    r.insert("price_f", price);
    r.insert("history", hist);
    r.insert("volume_f", vol);
    r.insert("dir_class", dir_for(pct));
    r.insert("price", fmt_price(price));
    r.insert("volume", fmt_volume(vol));
    r.insert("change", fmt_change(pct));
    let buckets = sparkline_buckets(hist);
    let b = 0;
    while b < 8 {
        r.insert("spark" + str(b), buckets[b]);
        b += 1;
    }
    let name = "";
    if item.contains("name") && is_str(item.get("name")) {
        name = as_str(item.get("name"));
    }
    r.insert("name", name);
    r.insert("rank", "#" + str(rank));
    return r;
}

// The current rows keyed by symbol, so a refresh can find each coin's history.
fn index_prev() {
    let idx = {};
    let prev = as_list(signal_array("rows").all());
    for pr in prev {
        let sym = as_str(as_map(pr).get("symbol"));
        idx.insert(sym, pr);
    }
    return idx;
}

fn on_fetch(tag: string, body: string) {
    if tag != "coingecko" { return; }
    let parsed = lumen::parse_json(body);
    if !is_list(parsed) { return; }
    let coins = as_list(parsed);
    let prev_idx = index_prev();
    let next = empty_list();
    let total_cap = 0.0;
    let gainers = 0;
    let losers = 0;
    let j = 0;
    while j < coins.len() {
        let item = as_map(coins[j]);
        next.push(make_row(item, prev_idx, j + 1));
        total_cap += num_field(item, "market_cap");
        let p = num_field(item, "price_change_percentage_24h");
        if p > 0.0 { gainers += 1; }
        else if p < 0.0 { losers += 1; }
        j += 1;
    }
    signal_array("rows").set(next);
    rebuild_visible();

    let refreshes = signal<int>("refresh_count");
    let refr = refreshes.get() + 1;
    refreshes.set(refr);
    signal<string>("updated_label").set("refresh #" + str(refr));
    signal<string>("feed_status").set("live - " + str(next.len()) + " coins");
    signal<string>("cap_label").set(fmt_cap(total_cap));
    signal<string>("cap_sub").set("total cap, top " + str(next.len()));
    signal<string>("gainers_label").set(str(gainers));
    signal<string>("losers_label").set(str(losers));
}

fn on_fetch_error(tag: string, msg: string) {
    if tag != "coingecko" { return; }
    signal<string>("feed_status").set("feed error: " + msg);
    signal<string>("updated_label").set("feed error");
}

fn do_fetch() {
    signal<string>("feed_status").set("fetching...");
    lumen::fetch("https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=80&page=1&sparkline=false&price_change_percentage=24h", "coingecko");
}

fn handle_refresh(id: string) { do_fetch(); }

fn handle_pause(id: string) {
    let paused = signal<string>("paused");
    if paused.get() == "1" {
        paused.set("");
        signal<string>("pause_label").set("Pause auto-refresh");
    } else {
        paused.set("1");
        signal<string>("pause_label").set("Resume auto-refresh");
    }
}

fn handle_clear(id: string) {
    signal_array("rows").set(empty_list());
    signal_array("visible").set(empty_list());
    signal<string>("empty_visible").set("1");
    refresh_counts(0, 0);
}

fn handle_tick(name: string) {
    if signal<string>("paused").get() == "1" { return; }
    do_fetch();
}

fn handle_search(id: string, text: string) {
    if id == "search" {
        signal<string>("filter").set(text);
        rebuild_visible();
    }
}

fn on_start() {
    signal<string>("filter").set("");
    signal<string>("paused").set("");
    signal<string>("pause_label").set("Pause auto");
    signal<int>("refresh_count").set(0);
    signal<string>("rows_label").set("0");
    signal<string>("ticks_label").set("auto-refresh - 30s");
    signal<string>("updated_label").set("idle");
    signal<string>("feed_status").set("loading...");
    signal<string>("empty_visible").set("");
    signal<string>("cap_label").set("-");
    signal<string>("cap_sub").set("");
    signal<string>("gainers_label").set("-");
    signal<string>("losers_label").set("-");

    lumen::on("click", "refresh", "handle_refresh");
    lumen::on("click", "pause", "handle_pause");
    lumen::on("click", "clear", "handle_clear");
    lumen::on("text_input", "search", "handle_search");
    lumen::on("timer", "tick", "handle_tick");

    do_fetch();
    lumen::set_interval("tick", 30000);
}

fn main() {}
