<root bg="linear-gradient(160deg, #1e3a5f 0%, #2d5a8f 35%, #3a78b8 65%, #2553a0 100%)">

  <template name="day">
    <column class="day" id="day-{idx}" tab-index="{tab}" width="120px" height="100%">
      <label class="day-name" id="day-{idx}-name" width="100%" height="20px" text="{name}" />
      <image class="day-icon" id="day-{idx}-icon" src="icons/{icon}.png" width="56px" height="56px" />
      <label class="day-temp" id="day-{idx}-temp" width="100%" height="28px" text="—°" />
    </column>
  </template>

  <!-- TOP BAR -->
  <row width="100%" height="80px" padding="16 32" gap="12" align="center">
    <tile class="chip" width="180px" height="44px" padding="0 18" text-align="center"
          font-size="14" text="Lumen · Weather" />
    <spacer />
    <input class="chip" id="search" tab-index="0"
           width="460px" height="44px" padding="0 22" font-size="15"
           placeholder="Search a city · Paris, Tokyo, Reykjavik…" />
    <tile class="chip" id="unit" tab-index="1"
          width="68px" height="44px" padding="0 14" text-align="center"
          font-size="15" text="°C" />
    <spacer />
    <label class="caption" width="160px" height="44px" padding="0 8"
           text="powered by Open-Meteo" />
  </row>

  <!-- HERO -->
  <row width="100%" grow="1" padding="20 48" gap="32" align="center">
    <column height="100%" grow="1" justify="center" gap="8">
      <label class="title"    id="hero-city"      width="100%" height="76px"
             text="Pick a city" />
      <label class="subtitle" id="hero-condition" width="100%" height="32px"
             text="Tap the search box and press Enter" />
      <row align="end" gap="22" padding="14 0 0 0">
        <label class="metric" id="hero-temp" width="220px" height="120px" text="—°" />
        <column gap="6" justify="end" padding="0 0 22 0">
          <label class="metric-sub"      id="hero-high" width="120px" height="30px"
                 text="H —°" />
          <label class="metric-sub-mute" id="hero-low"  width="120px" height="30px"
                 text="L —°" />
        </column>
      </row>
    </column>
    <column height="100%" width="220px" justify="center" align="center">
      <image id="hero-icon" src="icons/sun.png" width="180px" height="180px" />
    </column>
  </row>

  <!-- 7-DAY STRIP -->
  <scroll class="forecast-strip" id="forecast" width="100%" height="180px"
          scroll="x" sensitivity="0.55" inertia="0.4"
          padding="16 32" gap="12">
    <day idx="0" tab="2" name="Mon" icon="sun" />
    <day idx="1" tab="3" name="Tue" icon="cloud" />
    <day idx="2" tab="4" name="Wed" icon="rain" />
    <day idx="3" tab="5" name="Thu" icon="cloud" />
    <day idx="4" tab="6" name="Fri" icon="snow" />
    <day idx="5" tab="7" name="Sat" icon="sun" />
    <day idx="6" tab="8" name="Sun" icon="rain" />
  </scroll>

  <!-- FOOTER -->
  <row class="footer" width="100%" height="44px" padding="6 32" gap="14" align="center">
    <tile class="dropzone" id="dropzone" drop="true" tab-index="9"
          width="340px" height="28px" padding="0 14" text-align="start"
          text="Drop a file to import a city list" />
    <spacer />
    <label class="caption" id="status" height="28px" padding="0 6"
           text="Press Tab → type a city → Enter to fetch" />
  </row>

  <script src="main.lua" />
</root>
