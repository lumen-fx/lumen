// Lumen Widget Garden - candela logic on the dynamic DOM API.
//
// Every static showcase widget stays declarative in main.lmn. Only the Lists
// tab, which the Rhai version drove with signal_array + <for>, is built
// imperatively: main.lmn ships an empty <column id="todos-list"> and this
// script fills it with real elements (create / append, the Node method sugar
// over lumen.cdl's node_spawn / node_append). Adding a row appends one more
// element; the per-row layout lives in CSS classes.
//
// Scalar UI state stays in signals with bind-* in the markup. Derived labels
// recompute through derive(); the recompute body is referenced by function
// name and its parameters arrive as the current dep-signal values.

import "lumen.cdl";

// --- Lists tab: element-wise row building ---

// Spawn a <label class=cls> with text under `row`. node_set_attr splits the
// class on whitespace, so it also handles multi-class cells.
fn add_cell(row, cls, text) {
    let cell = create("label");
    cell.set_attr("class", cls);
    cell.set_text(text);
    row.append(cell);
}

// Append one list <row> built element by element. The row flex line and each
// cell's width / grow come from CSS classes; only class and text are set here.
fn add_todo_row(container, idx, label, status) {
    let row = create("row");
    row.set_attr("class", "list-row");
    container.append(row);
    add_cell(row, "li-idx", idx);
    add_cell(row, "li-label", label);
    add_cell(row, "pill", status);
}

fn update_todo_count() {
    let container = get_by_id("todos-list");
    if !container.exists() { return; }
    let n = container.children().len();
    let msg = str(n) + " rows (DOM-built)";
    lumen::signal_set("todo_count", msg);
}

// Initial list build. Runs from on_ready, past the first tick, so #todos-list
// is queryable.
fn render_todos() {
    let container = get_by_id("todos-list");
    if !container.exists() { return; }
    add_todo_row(container, "1", "Layout - taffy", "done");
    add_todo_row(container, "2", "Reactive signals", "done");
    add_todo_row(container, "3", "Frameless windows", "done");
    add_todo_row(container, "4", "OS theme detection", "done");
    add_todo_row(container, "5", "Native menu bar", "partial");
    add_todo_row(container, "6", "Multi-window", "todo");
    update_todo_count();
}

// --- Derived display labels ---

fn calc_email_valid(s: string) {
    if s.contains("@") { return "OK: valid"; }
    return "needs @";
}

fn calc_telemetry_status(v: any) {
    if v { return "on"; }
    return "off";
}

fn calc_click_label(n: any) {
    return "clicks: " + str(n);
}

fn calc_greeting(s: string) {
    if s == "" { return "(nobody yet)"; }
    return "hi, " + s + "!";
}

fn calc_toggle_status(v: any) {
    if v { return "dark mode"; }
    return "light mode";
}

// --- Lifecycle ---

fn on_start() {
    // Scalar state, seeded with real types so per-tick binding writes parse
    // back into the type each derive expects.
    signal<int>("clicks").set(0);
    signal<int>("volume").set(42);
    lumen::signal_set("who", "");
    signal<bool>("dark").set(true);
    lumen::signal_set("dialog_open", "");
    lumen::signal_set("weight", "medium");
    lumen::signal_set("fruit", "grape");
    lumen::signal_set("note", "");
    lumen::signal_set("email", "");
    lumen::signal_set("meet_date", "2026-05-20");
    lumen::signal_set("meet_time", "14:30");
    signal<bool>("telemetry").set(false);
    lumen::signal_set("dialog_verdict", "no verdict yet");

    // Counters kept in signals because each handler is a separate program call.
    signal<int>("accept_count").set(0);
    signal<int>("reject_count").set(0);
    signal<int>("hotkey_count").set(0);
    signal<int>("todo_next").set(7);

    lumen::signal_set("theme_status", "OS theme follows .theme-{light,dark} class on <root>");
    lumen::signal_set("hotkey_status", "Ctrl+Shift+L bound (anywhere)");
    lumen::signal_set("picked", "nothing picked yet");
    lumen::signal_set("todo_count", "rows built via the DOM API");

    // Computed labels drive the bound text declaratively.
    lumen::derive("email_valid", ["email"], "calc_email_valid");
    lumen::derive("telemetry_status", ["telemetry"], "calc_telemetry_status");
    lumen::derive("click_label", ["clicks"], "calc_click_label");
    lumen::derive("greeting", ["who"], "calc_greeting");
    lumen::derive("toggle_status", ["dark"], "calc_toggle_status");

    // Per-id click router. The OS-touching builtins live inside the handlers.
    lumen::on("click", "bump", "handle_bump");
    lumen::on("click", "reset", "handle_reset");
    lumen::on("click", "danger", "handle_danger");
    lumen::on("click", "notify", "handle_notify");
    lumen::on("click", "notify-2", "handle_notify");
    lumen::on("click", "theme-toggle", "handle_theme_toggle");
    lumen::on("click", "add-todo", "handle_add_todo");
    lumen::on("click", "open-dialog", "handle_open_dialog");
    lumen::on("click", "dialog-close", "handle_dialog_close");
    lumen::on("click", "dialog-confirm", "handle_dialog_close");
    // Exactly-once dialog verdict hooks: one fires per open/close cycle.
    lumen::on("dialog_accepted", "demo-dialog", "handle_dialog_accepted");
    lumen::on("dialog_rejected", "demo-dialog", "handle_dialog_rejected");
    lumen::on("click", "pick", "handle_pick");
    lumen::on("click", "open-actions-menu", "handle_open_menu");
    lumen::on("hotkey", "save", "handle_hotkey_save");
    // <menu> item dispatch routes here for the actions-menu items.
    lumen::on("menu", "rename", "handle_menu_action");
    lumen::on("menu", "duplicate", "handle_menu_action");
    lumen::on("menu", "delete", "handle_menu_action");

    lumen::register_hotkey("save", "CommandOrControl+Shift+L");
}

// on_ready fires on the first tick, after the DOM index is published, so
// #todos-list is queryable. The initial list build lives here.
fn on_ready() {
    render_todos();
}

// --- Handlers ---

fn handle_bump(id: any) {
    let clicks = signal<int>("clicks");
    clicks.set(clicks.get() + 1);
}

fn handle_reset(id: any) {
    signal<int>("clicks").set(0);
}

fn handle_danger(id: any) {
    lumen::notify("Lumen", "Pretend this was destructive.");
}

fn handle_notify(id: any) {
    lumen::notify("Lumen Widget Garden", "Native toast via notify-rust.");
}

fn handle_theme_toggle(id: any) {
    let dark = signal<bool>("dark");
    if dark.get() {
        dark.set(false);
        lumen::set_root_class("app theme-light");
        lumen::signal_set("theme_status", "override -> light");
    } else {
        dark.set(true);
        lumen::set_root_class("app theme-dark");
        lumen::signal_set("theme_status", "override -> dark");
    }
}

fn handle_add_todo(id: any) {
    let container = get_by_id("todos-list");
    if !container.exists() { return; }
    let next = signal<int>("todo_next");
    let n = next.get();
    let idx = str(n);
    let label = "Row " + str(n);
    add_todo_row(container, idx, label, "new");
    next.set(n + 1);
    update_todo_count();
}

fn handle_open_dialog(id: any) {
    lumen::signal_set("dialog_open", "1");
}

fn handle_dialog_close(id: any) {
    lumen::signal_set("dialog_open", "");
}

fn handle_dialog_accepted(id: any) {
    let accepted = signal<int>("accept_count");
    let m = accepted.get() + 1;
    accepted.set(m);
    let r = signal<int>("reject_count").get();
    let msg = "accepted x" + str(m) + ", rejected x" + str(r);
    lumen::signal_set("dialog_verdict", msg);
}

fn handle_dialog_rejected(id: any) {
    let rejected = signal<int>("reject_count");
    let m = rejected.get() + 1;
    rejected.set(m);
    let a = signal<int>("accept_count").get();
    let msg = "accepted x" + str(a) + ", rejected x" + str(m);
    lumen::signal_set("dialog_verdict", msg);
}

fn handle_pick(id: any) {
    lumen::pick_file("garden-open");
}

fn on_file_picked(tag: string, path: string) {
    if path == "" {
        lumen::signal_set("picked", "(cancelled)");
    } else {
        let msg = "picked: " + path;
        lumen::signal_set("picked", msg);
    }
}

fn handle_open_menu(id: any) {
    lumen::open_menu("actions");
}

fn handle_menu_action(id: string) {
    let msg = "Menu item fired: " + id;
    lumen::notify("Lumen Widget Garden", msg);
}

fn handle_hotkey_save(name: string) {
    let fired = "Hotkey fired (" + name + ")";
    lumen::notify("Lumen", fired);
    let count = signal<int>("hotkey_count");
    let np = count.get() + 1;
    let status = "Ctrl+Shift+L pressed " + str(np) + "x";
    lumen::signal_set("hotkey_status", status);
    count.set(np);
}

fn main() {}
