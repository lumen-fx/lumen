<root>
  <label id="hint" width="100%" height="20%" padding="0 0 24 24"
         text="Tab to focus the input, then type. Long-press clears." />
  <input id="textbox"
         width="80%" height="20%"
         margin="16" padding="20 0 24 20" radius="12"
         bg="#1a1a25" hover-bg="#22223a" text-color="#f0f0f8"
         placeholder="Type here..." />
  <label id="echo" width="100%" height="60%" padding="0 0 24 0"
         text="(committed text appears here)" />
  <script>
    fn render() {
        let buffer = signal("buffer", "");
        let s = buffer.get();
        if s == "" {
            set_text("echo", "(committed text appears here)");
        } else {
            set_text("echo", "Committed: " + s);
        }
    }

    // Fires on IME composition commit (CJK, dead-keys, etc.). For raw
    // ASCII keystrokes the input updates its own TextContent directly via
    // the type_into_focused system; no script callback needed.
    fn on_text_input(id, text) {
        if id == "textbox" {
            let buffer = signal("buffer", "");
            buffer.set(buffer.get() + text);
            render();
        }
    }

    fn on_long_press(id) {
        if id == "textbox" {
            signal("buffer", "").set("");
            set_text("textbox", "");
            render();
        }
    }
  </script>
</root>
