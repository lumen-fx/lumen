<root class="app">
  <column gap="12" padding="32">
    <label class="h1" text="Host builtin exposed to the script" />
    <label id="greeting" bind-text="greeting" text="(waiting for on_start)" />
  </column>

  <script>
    // `cpp_greeting` is a NATIVE builtin exposed from the C++ host with
    // app.expose(...). The script calls it like any Rhai function; the
    // return value flows back across the FFI and drives bind-text.
    fn on_start() {
        let msg = cpp_greeting("Lumen");
        signal("greeting", "").set(msg);
    }
  </script>
</root>
