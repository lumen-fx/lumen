#compdef lumenc
#
# zsh completion for lumenc.
#
# Install it as `_lumenc` in a directory on $fpath, for example:
#
#     mkdir -p ~/.zsh/completions
#     lumenc completions zsh > ~/.zsh/completions/_lumenc
#     echo 'fpath=(~/.zsh/completions $fpath)' >> ~/.zshrc
#
# `lumenc completions zsh` prints this file.

# Every subcommand lumenc dispatches. Kept in step with `lumenc --help` by
# public/lumenc/tests/completions.rs.
_lumenc_commands() {
    local -a commands
    commands=(
        'run:Run an app'
        'check:Parse an app without opening a window'
        'build:Ahead-of-time compile an app to a .lmna artifact'
        'new:Scaffold an app directory from a template'
        'fmt:Reformat a .lmn markup file'
        'snapshot:Text dump of the running app'
        'find:Selector search over the live snapshot'
        'element-at:Topmost element at a point'
        'click:Inject a click'
        'type:Type a string into the focused element'
        'key:Inject one key press'
        'scroll:Inject a wheel event'
        'lint:Lint the running app, or lint sources offline'
        'diff:Show what changed in the running app'
        'screenshot:Capture the running app to a PNG'
        'web:Emit the app as a static site'
        'bundle:Pack an app, or build a trimmed runtime for it'
        'package:Assemble a folder to ship'
        'i18n:Translation catalogue tooling'
        'completions:Print a shell completion script'
    )
    _describe -t commands 'lumenc command' commands
}

# Flags every automation subcommand takes.
_lumenc_mcp_args=(
    '--port[MCP port]:port:'
    '--app[App directory to read the MCP port from]:directory:_directories'
)

_lumenc() {
    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '(- *)'{-h,--help}'[Show help]' \
        '(- *)'{-V,--version}'[Print version]' \
        '1: :_lumenc_commands' \
        '*:: :->args' && return 0

    case "$state" in
        args)
            case "$words[1]" in
                run)
                    _arguments \
                        '--profile[Write a trace or connect to a profiler]:mode:(chrome tracy stderr)' \
                        '--headless[Run the full pipeline with no window]' \
                        '--size[Logical viewport, as WxH]:size:' \
                        '--dpr[Scale the offscreen target]:factor:' \
                        '--ticks[Run exactly N ticks, then exit]:count:' \
                        '--artifact[Run a precompiled artifact]:file:_files -g "*.lmna"' \
                        '--assets[Read assets from a .lpak archive]:file:_files -g "*.lpak"' \
                        '--no-hooks[Skip the prebuild and prerun hooks]' \
                        '--help[Show help]' \
                        '1:app directory:_directories'
                    ;;
                check)
                    _arguments '--help[Show help]' '1:app directory:_directories'
                    ;;
                build)
                    _arguments \
                        '--no-hooks[Skip the prebuild hooks]' \
                        '--help[Show help]' \
                        '1:app directory:_directories' \
                        '2:artifact:_files -g "*.lmna"'
                    ;;
                new)
                    _arguments \
                        {-l,--list}'[Print the template gallery]' \
                        '--help[Show help]' \
                        '1:name:' \
                        '2:template:(blank hello counter form todo dashboard settings hotkeys)'
                    ;;
                fmt)
                    _arguments \
                        '--check[Exit non-zero when the file would change]' \
                        '--help[Show help]' \
                        '1:file:_files -g "*.lmn"'
                    ;;
                snapshot)
                    _arguments "${_lumenc_mcp_args[@]}" \
                        '--text[Indented text tree (default)]' \
                        '--json[Print the raw JSON-RPC result]' \
                        '--max-lines[Stop after N lines]:count:' \
                        '--cursor[Resume a truncated dump]:cursor:' \
                        '--include-invisible[Include elements the app is not painting]' \
                        '--no-omit-invisible[Alias for --include-invisible]' \
                        '--help[Show help]'
                    ;;
                find)
                    _arguments "${_lumenc_mcp_args[@]}" \
                        '--text[Match elements whose label contains this]:text:' \
                        '--role[Match elements with this a11y role]:role:' \
                        '--id[Match one entity id]:id:' \
                        '--limit[Stop after N hits]:count:' \
                        '--json[Print the raw JSON-RPC result]' \
                        '--help[Show help]'
                    ;;
                element-at)
                    _arguments "${_lumenc_mcp_args[@]}" \
                        '--json[Print the raw JSON-RPC result]' \
                        '--help[Show help]' \
                        '1:x:' \
                        '2:y:'
                    ;;
                click)
                    _arguments "${_lumenc_mcp_args[@]}" \
                        '--button[Mouse button]:button:(primary secondary middle)' \
                        '--wait-for[Block until this event ring records an entry]:ring:' \
                        '--json[Print the raw JSON-RPC result]' \
                        '--help[Show help]' \
                        '1:x:' \
                        '2:y:'
                    ;;
                type)
                    _arguments "${_lumenc_mcp_args[@]}" \
                        '--wait-for[Block until this event ring records an entry]:ring:' \
                        '--json[Print the raw JSON-RPC result]' \
                        '--help[Show help]' \
                        '1:text:'
                    ;;
                key)
                    _arguments "${_lumenc_mcp_args[@]}" \
                        '--shift[Hold shift]' \
                        '--ctrl[Hold ctrl]' \
                        '--alt[Hold alt]' \
                        '--super[Hold super]' \
                        '--cmd[Alias for --super]' \
                        '--wait-for[Block until this event ring records an entry]:ring:' \
                        '--json[Print the raw JSON-RPC result]' \
                        '--help[Show help]' \
                        '1:key:(Enter Tab Escape Backspace Delete Home End Left Right Up Down)'
                    ;;
                scroll)
                    _arguments "${_lumenc_mcp_args[@]}" \
                        '--wait-for[Block until this event ring records an entry]:ring:' \
                        '--json[Print the raw JSON-RPC result]' \
                        '--help[Show help]' \
                        '1:x:' '2:y:' '3:dx:' '4:dy:'
                    ;;
                lint)
                    _arguments "${_lumenc_mcp_args[@]}" \
                        '--css-cascade[Offline cascade-divergence check]' \
                        '--signals[Offline signal lint]' \
                        '--strict[Upgrade warnings to errors]' \
                        '--json[One JSON object per finding]' \
                        '--help[Show help]' \
                        '1:app directory:_directories'
                    ;;
                diff)
                    _arguments "${_lumenc_mcp_args[@]}" \
                        '--json[Print the raw JSON-RPC result]' \
                        '--help[Show help]' \
                        '1:tick:'
                    ;;
                screenshot)
                    _arguments "${_lumenc_mcp_args[@]}" \
                        '--highlight[Outline these entity ids]:ids:' \
                        '--lint[Outline every lint finding]' \
                        '--bounds[Also write the entity bounds map as JSON]:file:_files' \
                        '--help[Show help]' \
                        '1:output png:_files -g "*.png"'
                    ;;
                web)
                    _arguments \
                        '--out[Where the site is written]:directory:_directories' \
                        '--base[URL prefix the site is served under]:path:' \
                        '*--locale[Locale to emit a document tree for]:tag:' \
                        '--render[Where the pages come from]:mode:(static csr ssr)' \
                        '--runtime[Put the browser runtime in the documents]' \
                        '--no-runtime[Leave the browser runtime out]' \
                        '--prerender[Where the rendered state comes from]:mode:(seeds run none)' \
                        '--no-hooks[Skip the prebuild hooks]' \
                        '--lib-dir[Directory holding the browser runtime]:directory:_directories' \
                        '--strict[Fail the build on any warning]' \
                        '--serve[Serve the site and print the URL]' \
                        '--port[Port to serve on]:port:' \
                        '--host[Address to listen on]:address:' \
                        '*--allow-host[Let a render ask this host for data]:host:' \
                        '--help[Show help]' \
                        '1:app directory:_directories'
                    ;;
                bundle)
                    _arguments \
                        '--static[Build a trimmed runtime for the app]' \
                        '--no-hooks[Skip the prebuild hooks]' \
                        '--help[Show help]' \
                        '1:app directory:_directories' \
                        '2:output:_files'
                    ;;
                package)
                    _arguments \
                        '--name[Package name]:name:' \
                        '--target[Platform to package for]:target:(linux-x86_64 linux-aarch64 macos-x86_64 macos-aarch64 windows-x86_64)' \
                        '--lib-dir[Directory holding the platform files]:directory:_directories' \
                        '--no-hooks[Skip the prebuild hooks]' \
                        '--help[Show help]' \
                        '1:app directory:_directories' \
                        '2:output directory:_directories'
                    ;;
                i18n)
                    _arguments \
                        '--lang[BCP-47 tag naming the catalogue to write]:tag:' \
                        '--help[Show help]' \
                        '1:subcommand:(extract)' \
                        '2:app directory:_directories'
                    ;;
                completions)
                    _arguments '--help[Show help]' '1:shell:(bash zsh fish)'
                    ;;
            esac
            ;;
    esac
}

_lumenc "$@"
