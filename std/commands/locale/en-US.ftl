# The commands module's own strings. An app rewords or translates one by
# writing the same message id in its own catalogue.

# The palette's own command, as the palette and a menu item naming it show it.
lumen-commands-palette = Show all commands

# The palette's search field, before anything is typed.
lumen-commands-palette-placeholder = Type a command

# The palette's list when no command matches what was typed.
lumen-commands-palette-empty = No commands
