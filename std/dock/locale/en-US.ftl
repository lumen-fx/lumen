# The dock module's own strings. An app rewords or translates one by writing
# the same message id in its own catalogue.

# A tab's close button and the tab menu item that closes the panel. The
# button's accessible name is this word before the panel's title.
lumen-dock-close = Close

# The tab menu, opened by a right click, the Menu key or Shift+F10 on a tab.
lumen-dock-move-to-window = Move to new window
lumen-dock-move-group-to-window = Move group to new window
lumen-dock-dock-back = Dock back
lumen-dock-maximize = Maximize
lumen-dock-restore = Restore layout

# What a screen reader hears after a panel moves, after the panel's title.
lumen-dock-moved-to-window = moved to a new window
lumen-dock-docked-back = docked back
lumen-dock-moved-beside = moved beside
lumen-dock-moved = moved

# What a screen reader hears when Escape cancels a tab drag.
lumen-dock-drag-cancelled = Move cancelled
