// lumen.cdl: the Lumen candela host prelude.
//
// A `.cdl` app pulls in the ENTIRE Lumen host surface with one line:
//
//     import "lumen.cdl";
//
// in lieu of hand-declaring a `host "lumen" { ... }` block. The CandelaHost source
// preparation step (lumen-script-candela `resolve_prelude`) detects that import
// and splices this block in before the source reaches `candela::Engine::compile`.
//
// SOURCE OF TRUTH: every declaration here mirrors a `register_host_fn` call in
// `CandelaHost::build_engine` and its matching `BUILTINS` entry. candela type-checks
// each declared host fn against its registered closure at compile time, and the
// `prelude_declares_every_builtin` test guards the two against drift. candela int
// = i32/i64 scalar; a bare `name(args);` returns null (`()`).
host "lumen" {
    // app-command emitters
    add_clicks(int);
    set_string(string, string);
    set_text(string, string);
    set_src(string, string);

    // signals (string + typed scalars)
    string signal_get(string);
    signal_set(string, string);
    int signal_get_int(string);
    signal_set_int(string, int);
    float signal_get_float(string);
    signal_set_float(string, float);
    bool signal_get_bool(string);
    signal_set_bool(string, bool);

    // timers
    set_timeout(string, int);
    set_interval(string, int);
    cancel_timer(string);

    // notifications / clipboard / tray
    notify(string, string);
    copy_image(string);
    save_clipboard_image(string);
    tray_icon(string, string, string);
    unregister_tray(string);

    // menus
    open_menu(string);
    close_menu(string);

    // file dialogs
    pick_file(string);
    pick_files(string);
    pick_folder(string);
    save_file(string, string);
    pick_file_filtered(string, string);

    // hotkeys
    register_hotkey(string, string);
    unregister_hotkey(string);

    // dynamic DOM read side (node ids interned host-side; 0 = no node)
    int[] node_query(string);
    int node_get_by_id(string);
    int node_document();
    int node_parent(int);
    int node_first_child(int);
    int node_last_child(int);
    int node_next(int);
    int node_prev(int);
    int[] node_children(int);
    int node_closest(int, string);
    bool node_valid(int);

    // dynamic DOM write side (phases 2 + 3): mutate the tree the app renders.
    // node_spawn / node_clone_deep mint a reserved-token id valid this tick.
    int node_spawn(string);
    int node_clone_deep(int);
    node_set_attr(int, string, string);
    node_remove_attr(int, string);
    node_set_id(int, string);
    node_set_text(int, string);
    node_set_inner_markup(int, string);
    node_class_add(int, string);
    node_class_remove(int, string);
    node_class_toggle(int, string);
    node_set_class(int, string);
    node_set_style(int, string, string);
    node_style_remove(int, string);
    node_remove(int);
    node_append(int, int);
    node_insert_before(int, int, int);
    node_set_parent(int, int);
    node_move_to(int, int);
    node_replace_with(int, int);

    // DOM read-backs on a single node.
    string node_get_attr(int, string);
    string node_text(int);
    string node_id(int);
    bool node_class_contains(int, string);
    string node_style_get(int, string);
    string node_computed_style(int, string);

    // low-level introspection (scalar + array shapes; the map-returning
    // readers -- node_rect, node_scroll, node_computed_style_all, node_attrs --
    // are registered but omitted here: candela host blocks declare scalar and
    // homogeneous-array returns, not maps).
    bool node_is_visible(int);
    int node_z_index(int);
    string[] node_classes(int);
    string[] node_components(int);
    string node_outer_markup(int);
    string node_inner_markup(int);
    string dump_tree();

    // event objects (phase 4): bind a handler by name, read the current event
    // through the accessors keyed by the event id the handler receives.
    int event_on(int, string, string);
    int event_on_capture(int, string, string);
    event_off(int);
    int event_target(int);
    int event_current_target(int);
    string event_type(int);
    string event_key(int);
    string event_value(int);
    int event_button(int);
    float event_x(int);
    float event_y(int);
    float event_client_x(int);
    float event_client_y(int);
    float event_delta_x(int);
    float event_delta_y(int);
    bool event_shift(int);
    bool event_ctrl(int);
    bool event_alt(int);
    bool event_super(int);
    event_prevent_default(int);
    event_stop_propagation(int);
    event_stop_immediate_propagation(int);

    // classes
    set_class(string, string);
    set_root_class(string);

    // networking
    fetch(string, string);

    // filesystem
    string read_file(string);
    bool write_file(string, string);

    // per-id handler routing
    on(string, string, string);

    // derived signals (recompute body referenced by function name)
    derive(string, string[], string);

    // audio transport
    audio_play(string);
    audio_pause();
    audio_resume();
    audio_stop();
    audio_seek(float);
    audio_volume(float);
}

// window / document / history live in their own host namespaces (section 4.8),
// so they are separate blocks. A candela app imports the prelude once and
// reaches these as window::set_title(...), document::get_by_id(...), etc.
host "window" {
    set_href(string);
    string href();
    reload();
    string title();
    float dpr();
    set_title(string);
    set_size(float, float);
    string location_path();
    string location_query();
    string location_hash();
}

host "history" {
    back();
    forward();
    go(int);
}

host "document" {
    int root();
    int[] query(string);
    int get_by_id(string);
    int focused();
    int hovered();
    int spawn(string);
}

// Element-wise row building helper. On the precompiled (AOT) path the
// from-source markup parser is absent, so node_set_inner_markup is a no-op and
// lists are built node by node. lm_append spawns a `tag` element, gives it a
// class and text, appends it under `parent`, and returns the new node id, so a
// row is one call instead of five. Pass "" for cls or text to skip that step.
fn lm_append(parent, tag, cls, text) {
    let e = lumen::node_spawn(tag);
    if cls != "" { lumen::node_class_add(e, cls); }
    if text != "" { lumen::node_set_text(e, text); }
    lumen::node_append(parent, e);
    return e;
}
