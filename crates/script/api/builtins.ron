// Every builtin the Lumen script hosts register, in one place.
//
// This file is the source of truth the three host tables are built from:
// `crates/script/api/build.rs` reads it at compile time and generates the
// per-host `&'static [BuiltinFn]` slices that `lumen_script::builtins`
// exports and each host crate re-exports as its own `BUILTINS`. Nothing
// parses this file at run time, so it costs the shipped runtime nothing.
//
// Adding a builtin means adding the registration in the host crate AND an
// entry here. Both parity directions are enforced by tests: every entry must
// name a function the host really registers, and every registration must have
// an entry.
//
// Fields
//
//   name      the name a script calls
//   hosts     which hosts expose it; a builtin absent from a host is simply
//             not listed for it
//   params    ordered (name, type) pairs, spelled in script types
//   ret       return type, "()" for a builtin that returns nothing
//   doc       one line, shown in LSP completion detail and hover
//   overrides per-host replacements for params / ret / doc, for the entries
//             whose shape differs by host: a Rhai `()` versus a Lua `nil`
//             versus a candela `0` on a miss, an untyped `map` versus
//             candela's `{string: string}`, or a closure argument versus the
//             function name candela passes instead. An override that omits a
//             field keeps the shared value.
//
// Types are the host's own spelling, because that is what an author reading
// hover text needs to see. candela names concrete types (`int[]`,
// `{string: float}`) since its host block is type-checked; Rhai and Lua name
// their dynamic shapes (`map`, `array`) and their handle types (`Node`,
// `Signal`).
(
    builtins: [
        (
            name: "add_clicks",
            hosts: [Rhai, Lua, Candela],
            params: [("n", "int")],
            ret: "()",
            doc: "Increment the app's click counter by `n`.",
        ),
        (
            name: "query",
            hosts: [Rhai, Lua],
            params: [("selector", "string")],
            ret: "NodeQuery",
            doc: "Run a CSS selector against the live tree; returns a NodeQuery result set.",
        ),
        (
            name: "get_by_id",
            hosts: [Rhai, Lua],
            params: [("id", "string")],
            ret: "Node",
            doc: "Fast id lookup; returns the matching Node or ().",
            overrides: [
                (
                    host: Lua,
                    doc: Some("Fast id lookup; returns the matching Node or nil."),
                ),
            ],
        ),
        (
            name: "document",
            hosts: [Rhai, Lua],
            params: [],
            ret: "Node",
            doc: "Return the document root Node.",
        ),
        (
            name: "dump_tree",
            hosts: [Rhai, Lua, Candela],
            params: [],
            ret: "string",
            doc: "Whole-tree structural dump (id / tag / classes / rect) for debugging.",
            overrides: [
                (
                    host: Candela,
                    doc: Some("Whole-tree structural dump for debugging."),
                ),
            ],
        ),
        (
            name: "pointer_state",
            hosts: [Rhai, Lua, Candela],
            params: [],
            ret: "map",
            doc: "Pointer position, buttons, and modifiers as a map.",
            overrides: [
                (
                    host: Candela,
                    ret: Some("{string: string}"),
                    doc: Some("Pointer position, buttons, and modifiers: `x`, `y`, `inside`, `buttons`, `shift`, `ctrl`, `alt`, `super`, stringified."),
                ),
            ],
        ),
        (
            name: "frame_info",
            hosts: [Rhai, Lua, Candela],
            params: [],
            ret: "map",
            doc: "Per-frame counters {frame, dt_ms, dirty_count} as a map.",
            overrides: [
                (
                    host: Candela,
                    ret: Some("{string: float}"),
                    doc: Some("Per-frame counters `frame`, `dt_ms`, `dirty_count`."),
                ),
            ],
        ),
        (
            name: "signals_all",
            hosts: [Rhai, Lua, Candela],
