// Asks an API for the part of the page nobody can know at build time, which
// is what a render has to wait for.
import "lumen.cdl";

fn main() {}

fn on_start() {
    lumen::signal_set("status", "asking");
    lumen::fetch("https://api.example.com/items", "items");
}

fn on_fetch(tag: string, body: string) {
    lumen::signal_set("status", body);
}

fn on_fetch_error(tag: string, message: string) {
    lumen::signal_set("status", "refused");
}
