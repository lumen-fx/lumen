<!--
  Lumen devtools overlay (v1). Authored in Lumen's own markup + CSS
  pipeline and shipped as an embedded asset (include_str!). The lumenc
  dev-mount parses this with the normal parser, spawns it as a second
  root, and lifts the root into the top paint band (OverlayLayer) so it
  floats over the app. Content is data-driven: the `dt-body` text is
  rewritten every tick from the in-process snapshot / network-capture ring.
-->
<row class="dt-overlay" width="100%" height="100%" justify="end">
  <column class="dt-panel" width="470" height="100%">
    <row class="dt-header" width="100%" justify="between">
      <label class="dt-title" text="Lumen devtools" />
      <label class="dt-hint" text="F12 to toggle" />
    </row>
    <row class="dt-tabbar" width="100%" gap="6">
      <button class="dt-tab" id="dt-tab-elements" text="Elements" />
      <button class="dt-tab" id="dt-tab-signals" text="Signals + Perf" />
      <button class="dt-tab" id="dt-tab-network" text="Network" />
    </row>
    <scroll class="dt-body-scroll" width="100%" height="100%">
      <label class="dt-body" id="dt-body" wrap="word" text="Lumen devtools loading..." />
    </scroll>
  </column>
</row>
