<root class="app">
  <column class="shell" gap="16" padding="32">
    <label class="h1" text="Lumen - C++ SDK Counter" />
    <label id="count-label" class="count" bind-text="label" text="0 clicks" />
    <row gap="0">
      <button id="decrement" class="btn" text="-1" />
      <button id="increment" class="btn" text="+1" />
      <button id="reset" class="btn-danger" text="Reset" />
    </row>
    <label class="hint" text="Signal count; count += 1 drives the bind-text label." />
  </column>

  <!--
    Clicks are routed natively per element id by the runtime (ABI 0.3):
    app.on_click(id, fn) registers through lumen_app_on_click, so no
    on_click(id) forwarding shim is needed in the markup. Native click
    routing does not fire under run_headless (no input is injected).
  -->
</root>
