*.ogg filter=lfs diff=lfs merge=lfs -text

# Small audio test fixtures must be present as raw bytes for offline/CI tests
# (an LFS pointer would break tests without a prior `git lfs pull`). Keep them
# out of LFS; the app's large soundtrack assets above stay on LFS.
crates/backends/audio-rodio/tests/fixtures/*.ogg -filter -diff -merge -text

# Linguist has no grammar for candela or .lmn markup yet, so map them to the
# nearest languages: candela highlights well as Rust, .lmn as XML. XML is a
# data language and excluded from the stats by default, so .lmn needs
# linguist-detectable to count.
*.cdl linguist-language=Rust
*.lmn linguist-language=XML linguist-detectable

# Shell completion scripts must stay LF everywhere: zsh and bash reject CRLF
# sources, and the parity test parses exact line boundaries in the embedded
# copies. Without this, a Windows checkout converts them and both break.
crates/lumenc/completions/* text eol=lf
# The .lmn parser is generated by tree-sitter from grammar.js; it is not
# hand-written C and does not belong in the language stats or in review diffs.
tools/tree-sitter-lumen/src/** linguist-generated
