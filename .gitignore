/target
# The `lumenc new` templates, which tools/fetch-templates.sh downloads from
# the repository each one is maintained in. They belong to no checkout: by
# default they land in cargo's target directory, ignored above, and this
# covers a fetch pointed at the checkout instead.
/templates
# Where `wasm-bindgen` puts the browser runtime module and its JS glue.
/web-dist
**/*.rs.bk
Cargo.lock.bak
.DS_Store
*.swp
.idea/
.vscode/
/lumen.toml.lock

# Profiler captures (chrome trace JSON).
/lumen-trace.json

# VS Code extension build artifacts
tools/vscode-lumen/node_modules/
tools/vscode-lumen/out/
tools/vscode-lumen/package-lock.json
tools/vscode-lumen/*.vsix

# Tree-sitter grammar tooling
tools/tree-sitter-lumen/node_modules/
tools/tree-sitter-lumen/package-lock.json

# Zed extension build artifacts (Zed compiles the extension in place)
tools/zed-lumen/target/
tools/zed-lumen/grammars/
tools/zed-lumen/Cargo.lock
tools/zed-lumen/extension.wasm

# C/C++ FFI consumer build dirs
apps/sysmon/build/
__pycache__/
*.pyc
.claude/

# Docs site build artifacts (Zensical)
/docs/site/
/docs/.venv/
/docs/.cache/

# Native libraries built by an app's [[hooks]] into its lib/ (see apps/notes).
apps/*/lib/

# Compiler-plugin emit outputs, regenerated by every compile.
.lumen/
